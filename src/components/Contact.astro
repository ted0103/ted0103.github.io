---
import Letters from './Letters.astro';
import { site } from '../config/site';
---
<section class="contact-section" id="contact"><div class="contact-intro"><svg class="contact-smile" viewBox="0 0 240 240" aria-hidden="true" data-pop><circle cx="120" cy="120" r="105" fill="#f7c948" stroke="#191510" stroke-width="3"/><path d="M88 90v30m64-30v30" stroke="#191510" stroke-width="18" stroke-linecap="round"/><circle cx="68" cy="143" r="14" fill="#ff4d8d" opacity=".4"/><circle cx="172" cy="143" r="14" fill="#ff4d8d" opacity=".4"/><path d="M76 154q44 49 88 0" fill="none" stroke="#191510" stroke-width="6" stroke-linecap="round"/></svg><h2><Letters text="LET’S TALK" /></h2><p class="hand" data-reveal>Got a project, a hard problem, or just want to say hi? Send it over. I read every message.</p><span class="invert-lens" aria-hidden="true"></span></div><div class="contact-banner"><div class="profile-note" data-reveal><span class="avatar-placeholder" aria-label="Portrait placeholder">☺</span><div><strong>{site.name}</strong><p>{site.availability}. Software, practical AI, and human-centred product design.</p><span class="note-reaction">✦ 1</span></div></div><a class="contact-card" href={`mailto:${site.email}`}><p class="hand">let’s make something together.</p><span class="contact-display">CONTACT</span><span class="project-link mono">drop a line ↗</span></a></div></section>
