---
import { site } from '../config/site';

const current = Astro.url.pathname;
---

<header class="site-header" data-site-header>
  <a class="brand" href="/">
    <span class="brand-mark" aria-hidden="true">TH</span>
    <span class="brand-name">Tan Ted Hang</span>
  </a>

  <nav class="desktop-nav" aria-label="Primary navigation">
    {
      site.navigation.map((item) => (
        <a
          href={item.href}
          aria-current={current === item.href || (item.href !== '/' && current.startsWith(item.href)) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>

  <a class="header-action" href={`mailto:${site.email}`}>Start a Conversation</a>

  <details class="mobile-nav">
    <summary aria-label="Open Navigation">
      <span></span><span></span>
    </summary>
    <nav aria-label="Mobile navigation">
      {
        site.navigation.map((item) => (
          <a
            href={item.href}
            aria-current={current === item.href || (item.href !== '/' && current.startsWith(item.href)) ? 'page' : undefined}
          >
            {item.label}<span aria-hidden="true">↗</span>
          </a>
        ))
      }
    </nav>
  </details>
</header>
