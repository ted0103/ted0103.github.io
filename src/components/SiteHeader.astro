---
import { site } from '../config/site';

const current = Astro.url.pathname;
---

<header class="site-header" data-site-header>
  <a class="site-mark" href="/" aria-label="Tan Ted Hang home"><span aria-hidden="true">T</span></a>

  <nav class="desktop-nav" aria-label="Primary navigation">
    {
      site.navigation.map((item) => (
        <a
          href={item.href}
          aria-current={current === item.href || (item.href !== '/' && current.startsWith(item.href)) ? 'page' : undefined}
        >
          <span class="nav-icon" aria-hidden="true">{item.icon}</span>
          {item.label}
        </a>
      ))
    }
  </nav>

  <div class="header-socials" aria-label="Social profiles">
    <a class="social-chip github-chip" href={site.github} aria-label="GitHub profile"><span aria-hidden="true">GH</span></a>
    <a class="social-chip instagram-chip" href={site.instagram} aria-label="Instagram profile"><span aria-hidden="true">◎</span></a>
  </div>
  <a class="header-action" href="/contact/"><span aria-hidden="true">♡</span> Contact</a>

  <details class="mobile-nav">
    <summary aria-label="Open Navigation">
      <span></span><span></span>
    </summary>
    <nav aria-label="Mobile navigation">
      {
        site.navigation.map((item) => (
          <a
            href={item.href}
            aria-current={current === item.href || (item.href !== '/' && current.startsWith(item.href)) ? 'page' : undefined}
          >
            <span class="nav-icon" aria-hidden="true">{item.icon}</span>{item.label}<span aria-hidden="true">↗</span>
          </a>
        ))
      }
      <a href="/contact/" aria-current={current === '/contact/' ? 'page' : undefined}>Contact<span aria-hidden="true">↗</span></a>
    </nav>
  </details>
</header>
