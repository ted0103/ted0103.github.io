---
import { site } from '../config/site';
---

<footer class="site-footer" data-reveal>
  <a class="footer-brand" href="/">Tan Ted Hang <span aria-hidden="true">✿</span></a>
  <nav class="footer-nav" aria-label="Footer navigation">
    {site.navigation.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <div class="footer-links" aria-label="Contact links">
    <a href={`mailto:${site.email}`}>Email</a>
    <a href={site.github}>GitHub</a>
    <a href={site.instagram}>Instagram</a>
  </div>
  <p class="footer-meta">Computer Science (Information Systems) · Development · Visual Storytelling</p>
  <p class="footer-meta footer-place">Malaysia · 2026</p>
</footer>
