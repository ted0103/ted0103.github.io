---
interface Props {
  accent: 'cyan' | 'violet';
  media: {
    src: string;
    alt: string;
    caption?: string;
    position: 'center' | 'top';
  };
  compact?: boolean;
}

const { accent, media, compact = false } = Astro.props;
---

<figure class:list={['project-visual', accent, { compact }]}>
  <img src={media.src} alt={media.alt} width="1470" height="890" loading="lazy" style={`object-position:${media.position}`} />
  <span class="visual-sheen" aria-hidden="true"></span>
  {media.caption && <figcaption>{media.caption}</figcaption>}
</figure>
