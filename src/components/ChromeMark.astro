---
interface Props { src: string; id: string; crop?: boolean; cutoff?: number; }
const { src, id, crop = false, cutoff = 1.1 } = Astro.props;
// Normalize the full-canvas favicon against the inset project symbols.
const size = src === "/favicon.svg" ? 384 : crop ? 608 : 512;
const offset = (512 - size) / 2;
const key = `arc-${id}`;
---
<svg class="chrome-mark" viewBox="0 0 512 512" aria-hidden="true" focusable="false">
  <defs>
    <filter id={`${key}-contrast`} color-interpolation-filters="sRGB">
      <feColorMatrix type="saturate" values="0" />
      <feComponentTransfer>
        <feFuncR type="linear" slope="4" intercept={String(-cutoff)} />
        <feFuncG type="linear" slope="4" intercept={String(-cutoff)} />
        <feFuncB type="linear" slope="4" intercept={String(-cutoff)} />
      </feComponentTransfer>
    </filter>
    <mask id={`${key}-shape`} maskUnits="userSpaceOnUse" x="0" y="0" width="512" height="512" style="mask-type:luminance">
      <image href={src} x={offset} y={offset} width={size} height={size} filter={`url(#${key}-contrast)`} />
    </mask>
    <linearGradient id={`${key}-metal`} x1=".15" y1="0" x2=".7" y2="1" gradientUnits="objectBoundingBox">
      <stop offset="0" stop-color="#10131e" />
      <stop offset=".27" stop-color="#3d4458" />
      <stop offset=".45" stop-color="#8998bd" />
      <stop offset=".51" stop-color="#fdf7ef" />
      <stop offset=".57" stop-color="#fff" />
      <stop offset=".73" stop-color="#d4ddf8" />
      <stop offset="1" stop-color="#566384" />
    </linearGradient>
  </defs>
  <g mask={`url(#${key}-shape)`}><rect width="512" height="512" fill={`url(#${key}-metal)`} /></g>
</svg>
<style>
.chrome-mark { display:block; width:100%; height:100%; overflow:visible; filter:drop-shadow(0 -1px 1px #c5dcff) drop-shadow(0 1px 1px #fff0db) drop-shadow(0 0 8px #97b4ff70) drop-shadow(0 8px 18px #a4b6ff28); }
@media(prefers-contrast:more) { .chrome-mark { filter:brightness(1.7); } }
</style>
