---
import ProjectVisual from './ProjectVisual.astro';

interface Props {
  projectIndex: number;
  project: {
    slug: string;
    title: string;
    eyebrow: string;
    summary: string;
    year: number;
    status: string;
    role: string;
    accent: 'cyan' | 'violet';
    media: {
      src: string;
      alt: string;
      width: number;
      height: number;
      caption?: string;
      position: 'center' | 'top';
    };
  };
}

const { project, projectIndex } = Astro.props;
---

<article class="project-card">
  <a class="project-card-link" href={`/projects/${project.slug}/`} aria-label={`View ${project.title} case study`}>
    <div class="project-card-meta">
      <span>Project {String(projectIndex).padStart(2, '0')}</span>
      <span>{project.year}</span>
    </div>
    <ProjectVisual accent={project.accent} media={project.media} />
    <div class="project-card-copy">
      <div class="project-card-title-row">
        <h3>{project.title}</h3>
        <span class="project-card-arrow" aria-hidden="true">↗</span>
      </div>
      <p class="project-card-summary">{project.summary}</p>
      <span class="project-card-cta">View case study</span>
      <div class="project-card-foot">
        <span>{project.eyebrow}</span>
        <span>{project.role}</span>
      </div>
    </div>
  </a>
</article>
