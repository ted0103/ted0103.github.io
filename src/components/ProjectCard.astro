---
import ProjectVisual from './ProjectVisual.astro';

interface Props {
  project: {
    slug: string;
    title: string;
    eyebrow: string;
    summary: string;
    year: number;
    status: string;
    accent: 'cyan' | 'violet';
    media: {
      src: string;
      alt: string;
      width: number;
      height: number;
      caption?: string;
      position: 'center' | 'top';
    };
    github: {
      language: string;
      updatedAt: string;
      source: 'live' | 'snapshot';
      snapshotGeneratedAt: string;
    };
  };
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const updated = new Intl.DateTimeFormat('en', { month: 'short', year: 'numeric' }).format(new Date(project.github.updatedAt));
---

<article class:list={['project-card', { featured }]}>
  <a class="project-card-link" href={`/projects/${project.slug}/`} aria-label={`View ${project.title} case study`}>
    <ProjectVisual accent={project.accent} media={project.media} />
    <div class="project-card-copy">
      <div class="project-card-meta">
        <span>{project.eyebrow}</span>
        <span>{project.year}</span>
      </div>
      <h3>{project.title}</h3>
      <p>{project.summary}</p>
      <div class="project-card-foot">
        <span>{project.status}</span>
        <span>{project.github.language || 'Multi-disciplinary'} · Repository activity {updated}</span>
        <span class="arrow" aria-hidden="true">↗</span>
      </div>
    </div>
  </a>
</article>
