---
import '../styles/fonts.css';
import '../styles/artsy.css';
import { site } from '../config/site';
import Socials from '../components/Socials.astro';
import Contact from '../components/Contact.astro';
interface Props { title?: string; playground?: boolean; }
const { title = 'Home', playground = false } = Astro.props;
const path = Astro.url.pathname;
const navigation = [{label:'Home',href:'/',icon:'★'}, {label:'About',href:'/about/',icon:'♟'}, {label:'Case Study',href:'/case-studies/',icon:'▦'}, {label:'Playground',href:'/playground/',icon:'◆'}];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={site.description}/><link rel="icon" href="/favicon.svg"/><link rel="preload" href="/fonts/handjet.woff2" as="font" type="font/woff2" crossorigin/><title>{title} · Tan Ted Hang</title></head><body class:list={[{ 'is-playground': playground }]}><a class="skip-link" href="#main">Skip to content</a><header class="site-header"><a class="smiley" href="/" aria-label="Tan Ted Hang home"><svg viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="17" fill="#ff4d8d" stroke="white" stroke-width="3"/><circle cx="14" cy="15" r="2" fill="white"/><circle cx="25" cy="15" r="2" fill="white"/><path d="M12 23q8 12 16-1" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round"/></svg></a><nav id="navigation" aria-label="Main navigation">{navigation.map(item => <a href={item.href} class:list={[{active:item.href==='/'?path==='/':path.startsWith(item.href)}]} aria-current={(item.href==='/'?path==='/':path.startsWith(item.href))?'page':undefined}><span aria-hidden="true">{item.icon}</span>{item.label}</a>)}</nav><div class="header-end"><Socials/><a class="contact-link mono" href="/#contact">♥ Contact</a><button class="menu-toggle" aria-label="Toggle menu" aria-controls="navigation" aria-expanded="false"><span></span><span></span><span></span></button></div></header><main id="main"><slot/></main>{!playground && <><Contact/><footer><div class="footer-name">TAN TED HANG</div><p class="mono footer-role">COMPUTER SCIENCE STUDENT</p><div class="footer-bottom"><nav aria-label="Footer navigation">{navigation.slice(1).map(item=><a href={item.href}>{item.label}</a>)}</nav><Socials/></div><p class="copyright mono">© 2026 Tan Ted Hang</p></footer></>}<script>import '../scripts/interactions';</script></body></html>
