---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../config/site';
import '../styles/global.css';
import '../styles/store-preview.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  themeColor?: string;
}

const {
  title,
  description = site.description,
  image = '/projects/portfolio-thumbnail-2026.webp',
  themeColor = '#f5f5f7',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url);
const fullTitle = title === site.name ? title : `${title} · ${site.name}`;
const socialImage = new URL(image, site.url);
---

<!doctype html>
<html lang="en" class="store-theme">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={themeColor} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{fullTitle}</title>
    {
      Astro.url.pathname === '/' && (
        <script is:inline>
          if (window.matchMedia('(display-mode: standalone)').matches) window.location.replace('/celestial-archive/');
        </script>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to Content</a>
    <div class="site-shell">
      <SiteHeader />
      <main id="main-content"><slot /></main>
      <SiteFooter />
    </div>
    <script>
      document.querySelectorAll('details.mobile-nav').forEach((menu) => {
        menu.addEventListener('toggle', () => menu.querySelector('summary')?.setAttribute('aria-label', menu.hasAttribute('open') ? 'Close Navigation' : 'Open Navigation'));
        addEventListener('pointerdown', (event) => {
          if (menu instanceof HTMLDetailsElement && menu.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
        });
      });
      addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        const menu = document.querySelector<HTMLDetailsElement>('details.mobile-nav[open]');
        if (menu) { menu.open = false; menu.querySelector<HTMLElement>('summary')?.focus(); }
      });

      // Preserve the existing numbered case-study layout; text remains readable without JS.
      document.querySelectorAll('[data-project-story]').forEach((story) => {
        const fragment = document.createDocumentFragment();
        let section: HTMLElement | null = null;
        Array.from(story.childNodes).forEach((node) => {
          if (node instanceof HTMLHeadingElement && node.tagName === 'H2') {
            section = document.createElement('section');
            section.className = 'project-story-section';
            fragment.append(section);
          }
          (section ?? fragment).append(node);
        });
        story.replaceChildren(fragment);
      });

      const motion = matchMedia('(prefers-reduced-motion: reduce)');
      let keyboardNavigation = false;
      addEventListener('keydown', () => { keyboardNavigation = true; });
      addEventListener('pointerdown', () => { keyboardNavigation = false; });
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            observer.unobserve(entry.target);
            if (!motion.matches && !keyboardNavigation && entry.boundingClientRect.top > 0) {
              entry.target.animate([
                { opacity: .75, transform: 'translateY(18px)' },
                { opacity: 1, transform: 'translateY(0)' },
              ], { duration: 280, easing: 'cubic-bezier(.23,1,.32,1)' });
            }
          }
        }, { threshold: .05 });
        const revealTargets = document.querySelectorAll('[data-reveal]:not(.store-hero):not(.store-route-hero):not(#selected-work), .store-selected-grid .project-card');
        revealTargets.forEach((element) => {
          observer.observe(element);
          element.addEventListener('focusin', () => element.getAnimations().forEach(animation => animation.cancel()));
        });
        motion.addEventListener('change', () => {
          if (motion.matches) revealTargets.forEach((element) => element.getAnimations().forEach((animation) => animation.cancel()));
        });
      }
    </script>
  </body>
</html>
