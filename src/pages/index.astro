---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactPanel from '../components/ContactPanel.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../config/site';
import { getProjects } from '../lib/projects';

const [profile] = await getCollection('profile');
const projects = await getProjects();
const categories = [
  { label: 'Selected work', mark: '✦', href: '#selected-work' },
  { label: 'Open source', mark: 'OS', href: '#open-source' },
  { label: 'About Ted', mark: 'TH', href: '/about/' },
  { label: 'Leadership', mark: '↗', href: '#leadership' },
  { label: 'Capabilities', mark: '⌘', href: '#capabilities' },
  { label: 'Contact', mark: '＋', href: '#contact' },
];
---

<BaseLayout title={site.name} themeColor="#f5f5f7">
  <div class="store-home">
    <section class="store-hero" data-reveal>
      <div>
        <p class="store-kicker">Independent portfolio · Malaysia</p>
        <h1>Portfolio</h1>
        <p class="store-headline">Work designed to feel clear, useful, and human.</p>
      </div>
      <aside aria-label="Portfolio introduction">
        <strong>Information Systems + AI.<br />Independent development.<br />Creative technology.</strong>
        <a href="mailto:tedhangtan@gmail.com">Start a conversation <span aria-hidden="true">↗</span></a>
        <a href="/about/">Meet Ted <span aria-hidden="true">↗</span></a>
      </aside>
    </section>

    <nav class="store-categories" aria-label="Explore portfolio">
      {categories.map((item) => (
        <a href={item.href}>
          <span aria-hidden="true">{item.mark}</span>
          <strong>{item.label}</strong>
        </a>
      ))}
    </nav>

    <section class="store-section" id="selected-work" aria-labelledby="projects-title" data-reveal>
      <header class="store-section-heading">
        <div>
          <h2 id="projects-title">The latest</h2>
          <p class="store-section-headline">Take a look at what I’m building now.</p>
        </div>
        <a href="/projects/">View all projects <span aria-hidden="true">↗</span></a>
      </header>
      <div class="project-grid store-project-rail">
        {projects.map((project, index) => <ProjectCard project={project} featured={index === 0} />)}
      </div>
    </section>

    <section class="store-section store-open-source" id="open-source" aria-labelledby="open-source-title" data-reveal>
      <header class="store-section-heading">
        <div>
          <h2 id="open-source-title">Tools for careful work.</h2>
          <p class="store-section-headline">Open-source tools for continuity, financial-code review, and consent-first phone outreach.</p>
        </div>
      </header>
      <div class="store-open-source-grid">
        <article class="store-open-source-card">
          <img
            src="/projects/ai-project-checkpoint-logo.png"
            width="512"
            height="512"
            loading="lazy"
            alt=""
          />
          <div>
            <p>Project continuity</p>
            <h3>Project Checkpoint</h3>
            <p>Portable, integrity-checked Git handoffs that preserve the working source and the next action.</p>
            <a href="https://github.com/ted0103/ai-project-checkpoint" aria-label="View the Project Checkpoint repository">
              View repository <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
        <article class="store-open-source-card">
          <img
            src="/projects/review-money-movement-logo.png"
            width="512"
            height="512"
            loading="lazy"
            alt=""
          />
          <div>
            <p>Financial code review</p>
            <h3>Review Money Movement</h3>
            <p>Evidence-first review for transfers, balances, refunds, settlement, and reconciliation.</p>
            <a href="https://github.com/ted0103/review-money-movement" aria-label="View the Review Money Movement repository">
              View repository <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
        <article class="store-open-source-card store-open-source-card--wide">
          <img
            src="/projects/callneuron-logo.png"
            width="1200"
            height="1200"
            loading="lazy"
            alt="CallNeuron phone handset and connected neural nodes logo"
          />
          <div>
            <p>Consent-first phone outreach</p>
            <h3>CallNeuron</h3>
            <p>An open-source CALL-E operator that turns an approved scholarship shortlist into one polite conversation and a clear human follow-up.</p>
            <div class="store-open-source-actions">
              <a href="https://github.com/ted0103/awesome-phone-call-agents/tree/feat/call-neuron/apps/typescript/call-neuron" aria-label="View the CallNeuron source contribution">
                View source <span aria-hidden="true">↗</span>
              </a>
              <a href="https://call-neuron-preview.pages.dev/" aria-label="Open the live CallNeuron operator">
                Open live <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="store-section" id="leadership" aria-labelledby="leadership-title" data-reveal>
      <header class="store-section-heading">
        <div>
          <h2 id="leadership-title">People first</h2>
          <p class="store-section-headline">Direction matters most when everyone can move together.</p>
        </div>
      </header>
      <div class="store-story-rail">
        <article class="store-story-card store-story-featured">
          <p>Leadership</p>
          <h3>Make the next step visible.</h3>
          <div>
            <p>Chairing a society taught me to listen before choosing a direction, translate complexity, and keep the human goal present while details change.</p>
            <a href="/about/">Read the longer story <span aria-hidden="true">↗</span></a>
          </div>
        </article>
        {profile.data.achievements.slice(0, 3).map((achievement, index) => (
          <article class="store-story-card store-achievement">
            <p>{String(index + 1).padStart(2, '0')} · Experience</p>
            <h3>{achievement}</h3>
          </article>
        ))}
      </div>
    </section>

    <section class="store-section" id="capabilities" aria-labelledby="capabilities-title" data-reveal>
      <header class="store-section-heading">
        <div>
          <h2 id="capabilities-title">The toolkit</h2>
          <p class="store-section-headline">Several ways to make one idea understandable.</p>
        </div>
      </header>
      <div class="store-capability-grid">
        {Object.entries(profile.data.tools).map(([label, tools], index) => (
          <article class:list={['store-capability-card', `tone-${index + 1}`]}>
            <span aria-hidden="true">{['⌘', '◌', '✦'][index]}</span>
            <div>
              <p>{label}</p>
              <h3>{tools.slice(0, 5).join(' · ')}</h3>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="store-section store-next" aria-labelledby="next-title" data-reveal>
      <p>Next experiment</p>
      <h2 id="next-title">Start with the human problem.</h2>
      <p>{profile.data.forecast}</p>
      <a href="mailto:tedhangtan@gmail.com">Build something meaningful together <span aria-hidden="true">↗</span></a>
    </section>

    <div class="store-section" id="contact">
      <ContactPanel />
    </div>
  </div>
</BaseLayout>
