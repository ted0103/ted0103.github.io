---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactPanel from '../components/ContactPanel.astro';
import PortfolioHero from '../components/PortfolioHero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../config/site';
import { getProjects } from '../lib/projects';

const [profile] = await getCollection('profile');
const projects = await getProjects();
const categories = [
  { label: 'Selected work', href: '#selected-work' },
  { label: 'Open source', href: '#open-source' },
  { label: 'Experience', href: '#leadership' },
  { label: 'Awards & education', href: '#awards' },
  { label: 'Tools & technologies', href: '#capabilities' },
  { label: 'Contact', href: '#contact' },
];
const toolGroups = [
  { label: 'Programming & web', tools: profile.data.tools.languages },
  { label: 'Development tools & workflows', tools: profile.data.tools.development },
  { label: 'Creative & design tools', tools: profile.data.tools.creative },
];
---

<BaseLayout title={site.name} themeColor="#f5f5f7">
  <div class="store-home">
    <PortfolioHero />

    <nav class="store-categories" aria-label="Explore portfolio" data-reveal>
      {categories.map((item, index) => (
        <a href={item.href}>
          <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <strong>{item.label}</strong>
        </a>
      ))}
    </nav>

    <section class="store-section" id="selected-work" aria-labelledby="projects-title" data-reveal>
      <header class="store-section-heading">
        <div>
          <h2 id="projects-title">Selected work</h2>
          <p class="store-section-headline">Projects, decisions, and details.</p>
        </div>
        <a href="/projects/">View all projects <span aria-hidden="true">↗</span></a>
      </header>
      <div class="project-grid store-selected-grid">
        {projects.map((project, index) => <ProjectCard project={project} featured={index === 0} />)}
      </div>
    </section>

    <section class="store-section store-open-source" id="open-source" aria-labelledby="open-source-title" data-reveal>
      <header class="store-section-heading">
        <div>
          <h2 id="open-source-title">Open-source tools</h2>
          <p class="store-section-headline">Open-source tools for continuity, financial-code review, consent-first phone outreach, and local file discovery.</p>
        </div>
      </header>
      <div class="store-open-source-grid">
        <article class="store-open-source-card">
          <img
            src="/projects/ai-project-checkpoint-logo.png"
            width="512"
            height="512"
            loading="lazy"
            alt=""
          />
          <div>
            <p>Project continuity</p>
            <h3>Project Checkpoint</h3>
            <p>Portable, integrity-checked Git handoffs that preserve the working source and the next action.</p>
            <a href="https://github.com/ted0103/ai-project-checkpoint" aria-label="View the Project Checkpoint repository">
              View repository <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
        <article class="store-open-source-card">
          <img
            src="/projects/review-money-movement-logo.png"
            width="512"
            height="512"
            loading="lazy"
            alt=""
          />
          <div>
            <p>Financial code review</p>
            <h3>Review Money Movement</h3>
            <p>Evidence-first review for transfers, balances, refunds, settlement, and reconciliation.</p>
            <a href="https://github.com/ted0103/review-money-movement" aria-label="View the Review Money Movement repository">
              View repository <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
        <article class="store-open-source-card">
          <img
            src="/projects/callneuron-logo.png"
            width="512"
            height="512"
            loading="lazy"
            alt="CallNeuron phone handset and connected neural nodes logo"
          />
          <div>
            <p>Consent-first phone outreach</p>
            <h3>CallNeuron</h3>
            <p>An open-source CALL-E operator that turns an approved scholarship shortlist into one polite conversation and a clear human follow-up.</p>
            <div class="store-open-source-actions">
              <a href="https://github.com/ted0103/awesome-phone-call-agents/tree/feat/call-neuron/apps/typescript/call-neuron" aria-label="View the CallNeuron source contribution">
                View source <span aria-hidden="true">↗</span>
              </a>
              <a href="https://call-neuron-preview.pages.dev/" aria-label="Open the live CallNeuron operator">
                Open live <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </article>
        <article class="store-open-source-card">
          <img
            src="/projects/find-my-files-logo.png"
            width="512"
            height="512"
            loading="lazy"
            alt="Find My Files folder, magnifier, and connected search-path logo"
          />
          <div>
            <p>Local file discovery</p>
            <h3>Find My Files</h3>
            <p>A local-only Codex skill for scoped macOS search, exact duplicates, and read-only file reports.</p>
            <a href="https://github.com/ted0103/find-my-files" aria-label="View the Find My Files repository">
              View repository <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      </div>
    </section>

    <section class="store-section" id="leadership" aria-labelledby="leadership-title" data-reveal>
      <header class="store-section-heading">
        <div>
          <h2 id="leadership-title">Experience &amp; leadership</h2>
          <p class="store-section-headline">Current responsibilities in publicity, public relations, and developer communities.</p>
        </div>
      </header>
      <div class="store-story-rail">
        {profile.data.leadership.map((position) => (
          <article class="store-story-card store-achievement">
            <img class="store-experience-logo" src={position.logo} alt={position.logoAlt} width="64" height="64" loading="lazy" />
            <p>{position.period}</p>
            <h3>{position.role}</h3>
            <div>
              <p>{position.organization}</p>
              <p>{position.summary}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="store-section" id="awards" aria-labelledby="awards-title" data-reveal>
      <header class="store-section-heading">
        <div>
          <h2 id="awards-title">Awards &amp; education</h2>
          <p class="store-section-headline">Study, academic results, and recognition.</p>
        </div>
      </header>
      <div class="store-story-rail">
        {profile.data.awards.map((award) => (
          <article class="store-story-card store-achievement">
            <p>{award.year ? `Recognition · ${award.year}` : 'International recognition'}</p>
            <h3>{award.title}</h3>
            <div><p>{award.summary}</p></div>
          </article>
        ))}
        <article class="store-story-card store-achievement">
          <p>Academic achievements</p>
          <h3>{profile.data.education.academicAchievements.join(' · ')}</h3>
          <div><p>Matriculation and SPM.</p></div>
        </article>
        <article class="store-story-card store-achievement">
          <p>{profile.data.education.level} · {profile.data.education.period}</p>
          <h3>{profile.data.education.degree}</h3>
          <div><p>{profile.data.education.institution}</p></div>
        </article>
      </div>
    </section>

    <section class="store-section" id="capabilities" aria-labelledby="capabilities-title" data-reveal>
      <header class="store-section-heading">
        <div>
          <h2 id="capabilities-title">Tools &amp; technologies</h2>
          <p class="store-section-headline">Programming, development workflows, and creative tools I have worked with.</p>
        </div>
      </header>
      <div class="store-capability-grid">
        {toolGroups.map(({ label, tools }, index) => (
          <article class:list={['store-capability-card', `tone-${index + 1}`]}>
            <span aria-hidden="true">{['⌘', '◌', '✦'][index]}</span>
            <div>
              <h3>{label}</h3>
              <ul>{tools.map((tool) => <li>{tool}</li>)}</ul>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="store-section store-next" aria-labelledby="next-title" data-reveal>
      <p>Next experiment</p>
      <h2 id="next-title">Start with the human problem.</h2>
      <p>{profile.data.forecast}</p>
      <a href="mailto:tedhangtan@gmail.com">Build something meaningful together <span aria-hidden="true">↗</span></a>
    </section>

    <div class="store-section" id="contact">
      <ContactPanel />
    </div>
  </div>
</BaseLayout>
