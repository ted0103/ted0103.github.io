---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactPanel from '../components/ContactPanel.astro';
import PortfolioHero from '../components/PortfolioHero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../config/site';
import { getProjects } from '../lib/projects';

const [profile] = await getCollection('profile');
const projects = await getProjects();
---

<BaseLayout title={site.name} themeColor="#faf9f6">
  <div class="store-home">
    <PortfolioHero />

    <section class="store-section store-about-preview" aria-labelledby="about-preview-title" data-reveal>
      <div class="about-preview-note">
        <p class="store-handnote">What’s up?</p>
        <div class="about-preview-copy">
          <h2 id="about-preview-title">A little about me</h2>
          <p>{site.description}</p>
          <div class="about-preview-tags" aria-label="Areas of interest">
            <span>Software development</span><span>Human-centred design</span><span>Visual storytelling</span>
          </div>
          <a href="/about/">Read my story <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <p class="about-preview-annotation" aria-hidden="true">ideas, built with care ↗</p>
    </section>

    <section class="store-section" id="selected-work" aria-labelledby="projects-title" data-reveal>
      <header class="store-section-heading">
        <div>
          <p class="store-handnote">Explore my work!</p>
          <h2 id="projects-title">Featured works</h2>
        </div>
        <a href="/projects/">View all projects <span aria-hidden="true">↗</span></a>
      </header>
      <div class="project-grid store-selected-grid">
        {projects.slice(0, 2).map((project, index) => <ProjectCard project={project} projectIndex={index + 1} />)}
      </div>
    </section>

    <section class="store-section store-roles-strip" aria-labelledby="roles-strip-title" data-reveal>
      <header class="store-section-heading">
        <div><p class="store-handnote">Current roles</p><h2 id="roles-strip-title">Communities I’m part of</h2></div>
        <a href="/about/#experience-title">See roles <span aria-hidden="true">↗</span></a>
      </header>
      <div class="roles-logo-row">
        {profile.data.leadership.map((position) => (
          <article class="role-logo-card">
            <img src={position.logo} alt={position.logoAlt} width="64" height="64" loading="lazy" />
            <div><h3>{position.role}</h3><p>{position.organization}</p></div>
          </article>
        ))}
      </div>
    </section>

    <section class="store-section store-next" aria-labelledby="next-title" data-reveal>
      <p>Next experiment</p>
      <h2 id="next-title">Start with the human problem.</h2>
      <p>{profile.data.forecast}</p>
      <a href="mailto:tedhangtan@gmail.com">Build something meaningful together <span aria-hidden="true">↗</span></a>
    </section>

    <div class="store-section" id="contact">
      <ContactPanel />
    </div>
  </div>
</BaseLayout>
