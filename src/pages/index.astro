---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactPanel from '../components/ContactPanel.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../config/site';
import { getProjects } from '../lib/projects';
import '../styles/store-preview.css';

const [profile] = await getCollection('profile');
const projects = await getProjects();
const categories = [
  { label: 'Selected work', mark: '✦', href: '#selected-work' },
  { label: 'About Ted', mark: 'TH', href: '/about/' },
  { label: 'Leadership', mark: '↗', href: '#leadership' },
  { label: 'Capabilities', mark: '⌘', href: '#capabilities' },
  { label: 'Contact', mark: '＋', href: '#contact' },
];
---

<BaseLayout title={site.name} themeColor="#f5f5f7">
  <div class="store-home">
    <section class="store-hero" data-reveal>
      <div>
        <p class="store-kicker">Independent portfolio · Malaysia</p>
        <h1><span>Portfolio.</span> Work designed to feel clear, useful, and human.</h1>
      </div>
      <aside aria-label="Portfolio introduction">
        <strong>Information Systems + AI.<br />Independent development.<br />Creative technology.</strong>
        <a href="mailto:tedhangtan@gmail.com">Start a conversation <span aria-hidden="true">↗</span></a>
        <a href="/about/">Meet Ted <span aria-hidden="true">↗</span></a>
      </aside>
    </section>

    <nav class="store-categories" aria-label="Explore portfolio">
      {categories.map((item) => (
        <a href={item.href}>
          <span aria-hidden="true">{item.mark}</span>
          <strong>{item.label}</strong>
        </a>
      ))}
    </nav>

    <section class="store-section" id="selected-work" aria-labelledby="projects-title" data-reveal>
      <header class="store-section-heading">
        <h2 id="projects-title"><span>The latest.</span> Take a look at what I’m building now.</h2>
        <a href="/projects/">View all projects <span aria-hidden="true">↗</span></a>
      </header>
      <div class="project-grid store-project-rail">
        {projects.map((project, index) => <ProjectCard project={project} featured={index === 0} />)}
      </div>
    </section>

    <section class="store-section" id="leadership" aria-labelledby="leadership-title" data-reveal>
      <header class="store-section-heading">
        <h2 id="leadership-title"><span>People first.</span> Direction matters most when everyone can move together.</h2>
      </header>
      <div class="store-story-rail">
        <article class="store-story-card store-story-featured">
          <p>Leadership</p>
          <h3>Make the next step visible.</h3>
          <div>
            <p>Chairing a society taught me to listen before choosing a direction, translate complexity, and keep the human goal present while details change.</p>
            <a href="/about/">Read the longer story <span aria-hidden="true">↗</span></a>
          </div>
        </article>
        {profile.data.achievements.slice(0, 3).map((achievement, index) => (
          <article class="store-story-card store-achievement">
            <p>{String(index + 1).padStart(2, '0')} · Experience</p>
            <h3>{achievement}</h3>
          </article>
        ))}
      </div>
    </section>

    <section class="store-section" id="capabilities" aria-labelledby="capabilities-title" data-reveal>
      <header class="store-section-heading">
        <h2 id="capabilities-title"><span>The toolkit.</span> Several ways to make one idea understandable.</h2>
      </header>
      <div class="store-capability-grid">
        {Object.entries(profile.data.tools).map(([label, tools], index) => (
          <article class:list={['store-capability-card', `tone-${index + 1}`]}>
            <span aria-hidden="true">{['⌘', '◌', '✦'][index]}</span>
            <div>
              <p>{label}</p>
              <h3>{tools.slice(0, 5).join(' · ')}</h3>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="store-section store-next" aria-labelledby="next-title" data-reveal>
      <p>Next experiment</p>
      <h2 id="next-title">Start with the human problem.</h2>
      <p>{profile.data.forecast}</p>
      <a href="mailto:tedhangtan@gmail.com">Build something meaningful together <span aria-hidden="true">↗</span></a>
    </section>

    <div class="store-section" id="contact">
      <ContactPanel />
    </div>
  </div>
</BaseLayout>
