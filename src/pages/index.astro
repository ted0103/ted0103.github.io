---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactPanel from '../components/ContactPanel.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../config/site';
import { getProjects } from '../lib/projects';

const [profile] = await getCollection('profile');
const projects = await getProjects();
---

<BaseLayout title={site.name}>
  <section class="hero">
    <div class="hero-prelude" aria-hidden="true">
      <span>Hello,</span>
      <span>I’m Ted.</span>
    </div>
    <div class="hero-copy">
      <div class="hero-heading">
        <p class="eyebrow">Independent Portfolio · 2026</p>
        <p class="hero-signature">Tan Ted Hang</p>
        <h1>
          <span class="hero-name">I build technology</span>
          <span class="hero-claim">with a human point of view.</span>
        </h1>
      </div>
      <div class="hero-context">
        <p class="hero-intro">{profile.data.intro}</p>
        <div class="hero-actions">
          <a class="button" href="#selected-work">Explore Selected Work <span aria-hidden="true">↓</span></a>
          <a class="text-link" href="/about/">More About Me <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
    <div class="hero-foot">
      <div class="chips" aria-label="Roles">
        <span class="chip">Information Systems + AI</span>
        <span class="chip">Independent Developer</span>
        <span class="chip">Creative Technologist</span>
      </div>
      <p class="availability">{site.availability}</p>
    </div>
  </section>

  <section class="section editorial-intro" aria-labelledby="intro-title" data-reveal>
    <p class="section-index">00 / Introduction</p>
    <div>
      <h2 id="intro-title">Technology makes sense when people can see themselves in it.</h2>
      <p>I’m an Information Systems and AI student, independent developer, and creative technologist. I’m interested in the space between a working system and a meaningful experience—the decisions that make complex ideas feel calm, useful, and worth trusting.</p>
    </div>
  </section>

  <section class="section" id="selected-work" aria-labelledby="projects-title" data-reveal>
    <div class="section-head">
      <div>
        <p class="section-index">01 / Selected Work</p>
        <h2 id="projects-title">Ideas made tangible.</h2>
      </div>
      <p>Two systems at different scales, connected by the same question: how can technology feel clearer and more considered?</p>
    </div>
    <div class="project-grid">
      {projects.map((project, index) => <ProjectCard project={project} featured={index === 0} />)}
    </div>
  </section>

  <section class="section story-section" aria-labelledby="profile-title" data-reveal>
    <div class="story-heading">
      <p class="section-index">02 / Leadership</p>
      <h2 id="profile-title">Direction matters. People matter more.</h2>
    </div>
    <div class="story-grid">
      <div class="story-copy">
        <p class="lead">Chairing a society taught me that leadership is less about having every answer and more about making the next step visible.</p>
        <p>I bring that mindset into product work: listen before choosing a direction, translate complexity into something a team can follow, and keep the human goal present while the details change.</p>
        <a class="text-link" href="/about/">Read the longer story <span aria-hidden="true">↗</span></a>
      </div>
      <div class="achievement-list">
        <ul class="signal-list">
          {profile.data.achievements.map((achievement, index) => (
            <li><span>{String(index + 1).padStart(2, '0')}</span>{achievement}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="stack-title" data-reveal>
    <div class="section-head">
      <div>
        <p class="section-index">03 / Capabilities</p>
        <h2 id="stack-title">One practice, several ways of making.</h2>
      </div>
      <p>The toolkit changes as I learn. The goal stays the same: make the work function clearly and communicate honestly.</p>
    </div>
    <div class="stack-grid">
      {Object.entries(profile.data.tools).map(([label, tools]) => (
        <div class="stack-group">
          <h3>{label[0].toUpperCase() + label.slice(1)}</h3>
          <div class="chips">
            {tools.map((tool) => <span class="chip">{tool}</span>)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section forecast-section" aria-labelledby="forecast-title" data-reveal>
    <div>
      <p class="section-index">04 / Next Experiment</p>
      <h2 id="forecast-title">Start with the human problem.</h2>
    </div>
    <div>
      <p>{profile.data.forecast}</p>
      <span class="forecast-orbit" aria-hidden="true">↗</span>
    </div>
  </section>

  <div class="section">
    <ContactPanel />
  </div>
</BaseLayout>
