---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const [profile] = await getCollection('profile');
const { Content } = await render(profile);
---

<BaseLayout title="About" description="The person, perspective, and experience behind Tan Ted Hang’s work." themeColor="#f5f5f7">
  <div class="store-about">
    <header class="store-route-hero" data-reveal>
      <p class="store-kicker">About · The Human Layer</p>
      <h1>About</h1>
      <p class="store-headline">I’m learning how to make complexity feel human.</p>
      <p class="store-intro">Technology is one part of the story. The rest is curiosity, leadership, visual judgment, and the patience to make an idea understandable.</p>
    </header>

    <section class="store-summary-tiles" aria-label="At a glance" data-reveal>
      <article><p>Based in</p><strong>{profile.data.location}</strong></article>
      <article><p>Studying</p><strong>Information Systems + AI</strong></article>
      <article><p>Leadership</p><strong>Society Chairperson</strong></article>
      <article><p>Practice</p><strong>Development + Creative Technology</strong></article>
    </section>

    <article class="content-prose store-about-story" data-reveal>
      <Content />
      <h2>What Comes Next</h2>
      <p>{profile.data.forecast}</p>
    </article>

    <section class="store-capability-shelf" aria-labelledby="capabilities-title" data-reveal>
      <header><p class="store-kicker">What I bring</p><h2 id="capabilities-title">Capabilities that keep the work human.</h2></header>
      <ul>{profile.data.capabilities.map((capability, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{capability}</li>)}</ul>
    </section>
  </div>
</BaseLayout>
