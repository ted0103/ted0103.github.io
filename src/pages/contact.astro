---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactPanel from '../components/ContactPanel.astro';
---

<BaseLayout title="Contact" description="Contact Tan Ted Hang by email, GitHub, or Instagram.">
  <header class="page-hero" data-reveal>
    <p class="section-index">Contact / Direct Lines</p>
    <h1>A good conversation is a useful place to begin.</h1>
    <p class="page-intro">For a thoughtful collaboration, a project conversation, or a simple hello—choose the channel that feels natural.</p>
  </header>

  <ContactPanel compact />
</BaseLayout>
