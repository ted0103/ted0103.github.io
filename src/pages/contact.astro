---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---

<BaseLayout title="Contact" description="Contact Tan Ted Hang by email, GitHub, or Instagram.">
  <header class="page-hero">
    <p class="eyebrow">Contact · Direct Lines</p>
    <h1>Let’s make the next idea clear.</h1>
    <p class="page-intro">For thoughtful collaborations, project conversations, or a simple hello—choose the channel that feels natural.</p>
  </header>

  <section class="contact-grid" aria-label="Contact options">
    <a class="contact-card" href={`mailto:${site.email}`}>
      <span>01 · Email</span>
      <strong>{site.email}</strong>
      <span>Start a Conversation ↗</span>
    </a>
    <a class="contact-card" href={site.github}>
      <span>02 · GitHub</span>
      <strong>ted0103</strong>
      <span>View Repositories ↗</span>
    </a>
    <a class="contact-card" href={site.instagram}>
      <span>03 · Instagram</span>
      <strong>@_hwalker_1</strong>
      <span>See the Visual Side ↗</span>
    </a>
  </section>
</BaseLayout>
