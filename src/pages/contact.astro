---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactPanel from '../components/ContactPanel.astro';
---

<BaseLayout title="Contact" description="Contact Tan Ted Hang by email, GitHub, or Instagram.">
  <div class="store-contact">
    <header class="store-route-hero" data-reveal>
      <p class="store-kicker">Contact · Direct Lines</p>
      <h1>Contact</h1>
      <p class="store-headline">Let’s talk about the work.</p>
      <p class="store-intro">For an internship opportunity, a product problem, or a thoughtful collaboration, choose the channel that feels natural.</p>
    </header>

    <ContactPanel compact />
  </div>
</BaseLayout>
