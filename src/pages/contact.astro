---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactPanel from '../components/ContactPanel.astro';
---

<BaseLayout title="Contact" description="Contact Tan Ted Hang by email, GitHub, or Instagram." themeColor="#f5f5f7">
  <div class="store-contact">
    <header class="store-route-hero" data-reveal>
      <p class="store-kicker">Contact · Direct Lines</p>
      <h1>Contact</h1>
      <p class="store-headline">A good conversation is a useful place to begin.</p>
      <p class="store-intro">For a thoughtful collaboration, a project conversation, or a simple hello—choose the channel that feels natural.</p>
    </header>

    <ContactPanel compact />
  </div>
</BaseLayout>
