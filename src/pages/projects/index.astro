---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/projects';

const projects = await getProjects();
const projectBySlug = new Map(projects.map((project) => [project.slug, project]));
const selectedProjects = ['celestial-archive', 'questmark', 'teds-personal-portfolio'].map((slug) => {
  const project = projectBySlug.get(slug);
  if (!project) throw new Error(`Missing featured project: ${slug}`);
  return project;
});
---

<BaseLayout title="Projects" description="Selected systems and experiments by Tan Ted Hang.">
  <div class="store-projects">
    <header class="store-route-hero" data-reveal>
      <p class="store-handnote">Explore my work!</p>
      <h1>Featured Works</h1>
      <p class="store-intro">A few products and systems I’ve helped make clearer, calmer, and easier to trust.</p>
    </header>

    <section class="store-project-supporting" aria-label="Featured projects" data-reveal>
      {selectedProjects.map((project, index) => (
        <ProjectCard project={project} projectIndex={index + 1} />
      ))}
    </section>
  </div>
</BaseLayout>
