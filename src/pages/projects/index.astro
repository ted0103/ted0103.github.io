---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/projects';

const projects = await getProjects();
const projectBySlug = new Map(projects.map((project) => [project.slug, project]));
const selectedProjects = ['celestial-archive', 'questmark', 'teds-personal-portfolio'].map((slug) => {
  const project = projectBySlug.get(slug);
  if (!project) throw new Error(`Missing featured project: ${slug}`);
  return project;
});
---

<BaseLayout title="Projects" description="Selected systems and experiments by Tan Ted Hang." themeColor="#f5f5f7">
  <div class="store-projects">
    <header class="store-route-hero" data-reveal>
      <p class="store-kicker">Projects · Curated Work</p>
      <h1>Projects</h1>
      <p class="store-headline">Built to be useful. Designed to be felt.</p>
      <p class="store-intro">A deliberately small collection of systems and visual experiments. Each case study explains the decisions, tradeoffs, and lessons behind the finished surface.</p>
    </header>

    <section class="store-project-feature" aria-labelledby="featured-project-title" data-reveal>
      <p class="store-kicker">Featured product</p>
      <h2 id="featured-project-title">{selectedProjects[0].title}</h2>
      <ProjectCard project={selectedProjects[0]} featured />
    </section>

    <section class="store-project-supporting" aria-label="More selected projects" data-reveal>
      {selectedProjects.slice(1).map((project) => <ProjectCard project={project} />)}
    </section>
  </div>
</BaseLayout>
