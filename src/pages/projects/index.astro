---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/projects';

const projects = await getProjects();
---

<BaseLayout title="Projects" description="Selected systems and experiments by Tan Ted Hang.">
  <header class="page-hero" data-reveal>
    <p class="section-index">Projects / Curated Work</p>
    <h1>Built to be useful. Designed to be felt.</h1>
    <p class="page-intro">A deliberately small collection of systems and visual experiments. Each case study explains the decisions, tradeoffs, and lessons behind the finished surface.</p>
  </header>

  <section class="project-index" aria-label="Project collection" data-reveal>
    <div class="project-grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</BaseLayout>
