---
import BaseLayout from '../layouts/BaseLayout.astro';
import Letters from '../components/Letters.astro';
const items=[['random shot','3%','6%','-3deg'],['what is this','56%','2%','2deg'],['hello world','30%','26%','3deg'],['first time','76%','24%','-2deg'],['20th take','6%','48%','2deg'],['practiceee','52%','52%','-3deg'],['uhm','80%','58%','3deg'],['found!','24%','66%','-2deg']];
---
<BaseLayout title="Playground" playground><section class="playground" aria-label="Photo playground"><div class="gallery-viewport" tabindex="0" role="region" aria-label="Photo board. Drag to pan; use arrow keys to pan, plus and minus to zoom, Home to reset."><div class="gallery-canvas"><div class="playground-heading" tabindex="0" aria-label="Just for fun. Drag or use arrow keys to move."><p class="hand">playground</p><h1><Letters text="JUST FOR FUN"/></h1></div>{items.map(([caption,x,y,tilt],index)=><figure class="gallery-photo" tabindex="0" aria-label={`${caption}, photo placeholder. Use arrow keys to move.`} style={`left:${x};top:${y};--tilt:${tilt};--delay:${index%4*.06}s`} data-pop><span class="gallery-caption hand">{caption}</span><div class="gallery-placeholder" role="img" aria-label="Space reserved for your photo"><svg viewBox="0 0 48 48" aria-hidden="true"><rect x="7" y="9" width="34" height="30" rx="2"/><circle cx="17" cy="18" r="3"/><path d="m8 33 10-10 8 8 5-5 10 10"/></svg><span class="hand">your photo here</span></div></figure>)}</div></div><button class="float-toggle mono" aria-pressed="false">Pause floating</button><div class="zoom-controls"><button aria-label="Zoom in">+</button><button aria-label="Zoom out">−</button></div><span class="sr-only" role="status" id="zoom-status">Zoom 100%</span></section></BaseLayout>
