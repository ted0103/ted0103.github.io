---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import { getProjects } from '../lib/projects';

const [profile] = await getCollection('profile');
const projects = await getProjects();
const toolGroups = [
  { label: 'Programming & web', tools: profile.data.tools.languages },
  { label: 'Development tools & workflows', tools: profile.data.tools.development },
  { label: 'Creative & design tools', tools: profile.data.tools.creative },
];
---

<BaseLayout title="Playground" description="Tools, project imagery, and creative interests from Tan Ted Hang’s practice.">
  <div class="store-playground">
    <header class="store-route-hero playground-hero" data-reveal>
      <p class="store-handnote">little things in progress</p>
      <h1>Playground</h1>
      <p class="store-intro">A visual notebook for the software, tools, and creative practice I’m building along the way.</p>
    </header>

    <section class="playground-board" aria-label="Project visuals" data-reveal>
      <div class="playground-board-note">
        <p class="store-handnote">From the work</p>
        <p>Real project imagery, collected in one place.</p>
      </div>
      <div class="playground-collage">
        {projects.map((project, index) => (
          <a class="playground-item" href={`/projects/${project.slug}/`} aria-label={`View the ${project.title} case study`}>
            <ProjectVisual accent={project.accent} media={project.media} compact />
            <div class="playground-caption">
              <span>Project {String(index + 1).padStart(2, '0')} · {project.year}</span>
              <h2>{project.title}</h2>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="store-section playground-tools" aria-labelledby="playground-tools-title" data-reveal>
      <header class="store-section-heading">
        <div><p class="store-handnote">Tools on the desk</p><h2 id="playground-tools-title">Tools &amp; technologies</h2></div>
      </header>
      <div class="store-capability-grid">
        {toolGroups.map(({ label, tools }) => (
          <article class="store-capability-card">
            <h3>{label}</h3>
            <ul>{tools.map((tool) => <li>{tool}</li>)}</ul>
          </article>
        ))}
      </div>
    </section>

    <section class="store-section playground-interests" aria-labelledby="playground-interests-title" data-reveal>
      <header class="store-section-heading">
        <div><p class="store-handnote">Curious about</p><h2 id="playground-interests-title">Areas I’m exploring</h2></div>
      </header>
      <ul class="playground-interest-tags">
        {profile.data.education.interests.map((interest, index) => (
          <li><span>{String(index + 1).padStart(2, '0')}</span>{interest}</li>
        ))}
      </ul>
    </section>

    <section class="store-section store-open-source" id="open-source" aria-labelledby="open-source-title" data-reveal>
      <header class="store-section-heading">
        <div>
          <p class="store-handnote">Made in the open</p>
          <h2 id="open-source-title">Open-source tools</h2>
          <p class="store-section-headline">Tools for continuity, financial-code review, consent-first phone outreach, and local file discovery.</p>
        </div>
      </header>
      <div class="store-open-source-grid">
        <article class="store-open-source-card">
          <img src="/projects/ai-project-checkpoint-logo.png" width="512" height="512" loading="lazy" alt="" />
          <div>
            <p>Project continuity</p>
            <h3>Project Checkpoint</h3>
            <p>Portable, integrity-checked Git handoffs that preserve the working source and the next action.</p>
            <a href="https://github.com/ted0103/ai-project-checkpoint" aria-label="View the Project Checkpoint repository">View repository <span aria-hidden="true">↗</span></a>
          </div>
        </article>
        <article class="store-open-source-card">
          <img src="/projects/review-money-movement-logo.png" width="512" height="512" loading="lazy" alt="" />
          <div>
            <p>Financial code review</p>
            <h3>Review Money Movement</h3>
            <p>Evidence-first review for transfers, balances, refunds, settlement, and reconciliation.</p>
            <a href="https://github.com/ted0103/review-money-movement" aria-label="View the Review Money Movement repository">View repository <span aria-hidden="true">↗</span></a>
          </div>
        </article>
        <article class="store-open-source-card">
          <img src="/projects/callneuron-logo.png" width="512" height="512" loading="lazy" alt="CallNeuron phone handset and connected neural nodes logo" />
          <div>
            <p>Consent-first phone outreach</p>
            <h3>CallNeuron</h3>
            <p>An open-source CALL-E operator that turns an approved scholarship shortlist into one polite conversation and a clear human follow-up.</p>
            <div class="store-open-source-actions">
              <a href="https://github.com/ted0103/awesome-phone-call-agents/tree/feat/call-neuron/apps/typescript/call-neuron" aria-label="View the CallNeuron source contribution">View source <span aria-hidden="true">↗</span></a>
              <a href="https://call-neuron-preview.pages.dev/" aria-label="Open the live CallNeuron operator">Open live <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </article>
        <article class="store-open-source-card">
          <img src="/projects/find-my-files-logo.png" width="512" height="512" loading="lazy" alt="Find My Files folder, magnifier, and connected search-path logo" />
          <div>
            <p>Local file discovery</p>
            <h3>Find My Files</h3>
            <p>A local-only Codex skill for scoped macOS search, exact duplicates, and read-only file reports.</p>
            <a href="https://github.com/ted0103/find-my-files" aria-label="View the Find My Files repository">View repository <span aria-hidden="true">↗</span></a>
          </div>
        </article>
      </div>
    </section>
  </div>
</BaseLayout>
